# Do not commit real values. BOT_TOKEN and OWNER_ID take precedence when set.
BOT_TOKEN=
OWNER_ID=

# Existing names remain supported for an existing installation.
token_BotFather=
TELEGRAM_ID=

# Telegram application credentials for the local Bot API server.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: HTTPS Anime365 API base URL.
ANI365_BASE_URL=https://smotret-anime.app/api

# Optional: check saved anime for new episodes every 600 seconds by default.
# Set a positive whole number of seconds; avoid an unnecessarily short interval.
WATCH_CHECK_INTERVAL=600
