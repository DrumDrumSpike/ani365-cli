# Do not commit real values. BOT_TOKEN and OWNER_ID take precedence when set.
BOT_TOKEN=
OWNER_ID=

# Existing names remain supported for an existing installation.
token_BotFather=
TELEGRAM_ID=

# Telegram application credentials for the local Bot API server.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: HTTPS Anime365 API base URL.
ANI365_BASE_URL=https://smotret-anime.app/api
# Required shared Anime365 access token. It is used only on the server and is
# never sent to Telegram users or the Mini App.
ANI365_TOKEN=

# Optional separate Hentai365 source for the Mini App. A bare domain is accepted
# and becomes https://hentai365.ru/api. Its token stays only on the server.
HENTAI_BASE_URL=hentai365.ru
HENTAI_TOKEN=

# Optional: check saved anime for new episodes every 600 seconds by default.
# Set a positive whole number of seconds; avoid an unnecessarily short interval.
WATCH_CHECK_INTERVAL=600

# Telegram Mini App. WEB_DOMAIN must point at this VDS and have ports 80/443 open;
# MINI_APP_URL is the same public HTTPS origin without a trailing slash.
WEB_DOMAIN=anime.example.com
MINI_APP_URL=https://anime.example.com
# Keep true in production. Set false only for a local HTTP development server.
WEB_COOKIE_SECURE=true
PLAYBACK_COMPLETION_THRESHOLD=0.9
# At most this many yt-dlp/ffmpeg jobs run at once. Ready browser downloads expire.
DOWNLOAD_WORKERS=2
DOWNLOAD_TTL=86400

# Optional Shikimori OAuth. The redirect URI in the Shikimori application must
# match this value exactly.
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
SHIKIMORI_REDIRECT_URI=https://anime.example.com/api/shikimori/callback
# Refresh selected Shikimori list statuses in the background. Minimum: 900.
SHIKIMORI_IMPORT_INTERVAL=43200
